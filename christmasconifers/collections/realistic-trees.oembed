ers":[{"title":"12' \/ Full \/ LED","offer_id":28982419488832,"sku":"KF-T12-L","price":2499.0,"currency_code":"USD","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0130\/8226\/3616\/files\/KingFlock_89f41dd8-9a44-41fb-8862-ab71fe91bba1.jpg?v=1714673353"},{"product_id":"9-foot-queen-flock-tree-unlit","title":"9' Queen Flock® Artificial Christmas Tree Unlit","description":"\u003cp\u003eTransform your home into an enchanted frost-kissed forest with the beautifully sculpted Queen Flock. Inspired by the majestic Alpine Fir of Washington’s wilderness, its snow-dusted branches and authentic silhouette create a cozy, wintry centerpiece. Perfectly detailed, it sets the stage for holiday traditions and cherished seasonal moments.\u003c\/p\u003e","brand":"King of Christmas","offers":[{"title":"9' \/ Full \/ Unlit","offer_id":28996987093056,"sku":"QF-T9-U","price":599.0,"currency_code":"USD","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0130\/8226\/3616\/products\/FlockedGroup-5_355ee261-f352-4da2-bf47-1e8f7ccee017.jpg?v=1718159039"},{"product_id":"10-foot-royal-fir-tree-led","title":"10' Royal Fir Artificial Christmas Tree with 1600 Warm White \u0026 Multi-Color LED Lights","description":"\u003cp\u003eElevate your holiday season with the authentically crafted Royal Fir, inspired by the grandeur of the stately Grand Fir and its iconic, lush greenery. Each branch is designed to showcase rich foliage, creating a warm, inviting centerpiece perfect for treasured traditions, cozy gatherings, and unforgettable holiday memories.\u003c\/p\u003e","brand":"King of Christmas","offers":[{"title":"10' \/ Full \/ LED","offer_id":28997011046464,"sku":"RF-T10-L","price":1899.0,"currency_code":"USD","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0130\/8226\/3616\/files\/RoyalFir_59c675e2-b8a7-4062-af58-098f2e9b8021.png?v=1722013217"},{"product_id":"7-5-foot-king-fraser-fir-tree-led","title":"7.5' King Fraser Fir Artificial Christmas Tree with 1000 Warm White \u0026 Multi-Color LED Lights","description":"\u003cp\u003eCelebrate the holiday season with the natural splendor of the Appalachian Mountains brought right into your home with the King Fraser Fir. Designed to mirror the majestic Fraser Fir, its lush foliage and classic conical shape really captures the authenticity of a real tree. Find the perfect size for your space and enjoy a holiday season full of lifelike charm.\u003c\/p\u003e","brand":"King of Christmas","offers":[{"title":"7.5' \/ Full \/ LED","offer_id":29211289747520,"sku":"KFF-T7.5-L","price":899.0,"currency_code":"USD","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0130\/8226\/3616\/files\/King-Fraser-Fir-Full-v2_160d23ca-59fa-432f-b172-052001ddf14f.jpg?v=1718158694"},{"product_id":"6-5-foot-king-fraser-fir-slim-tree-unlit","title":"6.5' King Fraser Fir Slim Artificial Christmas Tree Unlit","description":"\u003cp\u003eCelebrate the holiday season with the natural splendor of the Appalachian Mountains brought right into your home with the King Fraser Fir. Designed to mirror the majestic Fraser Fir, its lush foliage and classic conical shape really captures the authenticity of a real tree. Find the perfect size for your space and enjoy a holiday season full of lifelike charm.\u003c\/p\u003e","brand":"King of Christmas","offers":[{"title":"Default Title","offer_id":29211290304576,"sku":"KFFS-T6.5-U","price":299.0,"currency_code":"USD","in_stock":false}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0130\/8226\/3616\/files\/KingFraserFirUnlit.jpg?v=1786731058"},{"product_id":"7-5-foot-king-fraser-fir-slim-tree-unlit","title":"7.5' King Fraser Fir Slim Artificial Christmas Tree Unlit","description":"\u003cp\u003eCelebrate the holiday season with the natural splendor of the Appalachian Mountains brought right into your home with the King Fraser Fir. Designed to mirror the majestic Fraser Fir, its lush foliage and classic conical shape really captures the authenticity of a real tree. Find the perfect size for your space and enjoy a holiday season full of lifelike charm.\u003c\/p\u003e","brand":"King of Christmas","offers":[{"title":"7.5' \/ Slim \/ Unlit","offer_id":29211290435648,"sku":"KFFS-T7.5-U","price":359.0,"currency_code":"USD","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0130\/8226\/3616\/files\/KingFraserFirUnlit.jpg?v=1786731058"}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0130\/8226\/3616\/collections\/Queen_Flock_af2dc18b-8eb8-437b-810e-4f8a00392271.jpg?v=1722361733","url":"https:\/\/www.kingofchristmas.com\/collections\/realistic-trees.oembed","provider":"King of Christmas","version":"1.0","type":"link"}